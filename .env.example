# UnityLink OS — environment configuration template.
#
# Copy to `.env` and fill in real values. NEVER commit `.env` — it is
# gitignored. Generate strong random keys for production:
#   openssl rand -hex 32
#
# All values here are placeholders. Real secrets live only in the deployment
# environment / secret manager, never in the repository.

# ── Evidence vault (server/evidence-vault/api.mjs) ─────────────────────────
# Operator bearer token. REQUIRED in production; all vault data routes are
# operator-only. /api/health stays public for monitoring.
UNITYLINK_OPERATOR_KEY=change-me-generate-with-openssl-rand-hex-32
# Member bearer token (optional; reserved for the participant-facing surface).
UNITYLINK_MEMBER_KEY=change-me-generate-with-openssl-rand-hex-32
EVIDENCE_PORT=8788
EVIDENCE_DB=./data/evidence.db
EVIDENCE_VAULT_DIR=./data/vault
# Comma-separated origin allowlist; default * (dev only).
EVIDENCE_CORS=*

# ── Control-plane bridge (server/control-plane.mjs) ────────────────────────
# Paperclip control plane. The operator token stays server-side.
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_API_KEY=change-me-operator-or-agent-token
PAPERCLIP_COMPANY_ID=change-me-company-uuid
CONTROL_PLANE_PORT=8787
CONTROL_PLANE_CORS=*

# ── Production server (server/production.mjs) ──────────────────────────────
PROD_PORT=8080
PROD_DIST=./dist
# Comma-separated health endpoints the monitor polls.
MONITOR_URLS=http://127.0.0.1:8080/api/health

# ── Backups ────────────────────────────────────────────────────────────────
UNITYLINK_DB=./data/evidence.db
UNITYLINK_VAULT_DIR=./data/vault
UNITYLINK_BACKUP_DIR=./data/backups

# ── Logging ────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info